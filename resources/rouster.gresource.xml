<?xml version="1.0" encoding="UTF-8"?>
<!-- Rouster resource bundle. The resource-pipeline paradigm: an app asset carried
     the symbolic way (a currentColor SVG under the freedesktop icon-theme shape)
     so set_icon_name("rouster-logo-symbolic") resolves it out of the compiled-in
     binary and GTK recolours it to the theme foreground - no icon installed on
     the user's disk.

     Gotcha the shape encodes: GTK's icon lookup is RIGID about the trailing
     .../scalable/apps/ path, so the prefix ends there and App::on_activate
     passes only /io/github/scott8420/Rouster/icons to add_resource_path (GTK appends
     scalable/apps/ itself). The prefix mirrors the app-id; both move together in
     a one-pass rename. See docs/resources-and-dialog-lifetime.md. -->
<gresources>
  <gresource prefix="/io/github/scott8420/Rouster/icons/scalable/apps">
    <file preprocess="xml-stripblanks" alias="rouster-logo-symbolic.svg">icons/scalable/apps/rouster-logo-symbolic.svg</file>
    <file preprocess="xml-stripblanks" alias="rouster-scan-symbolic.svg">icons/scalable/apps/rouster-scan-symbolic.svg</file>
    <file preprocess="xml-stripblanks" alias="rouster-sweep-symbolic.svg">icons/scalable/apps/rouster-sweep-symbolic.svg</file>
    <file preprocess="xml-stripblanks" alias="rouster-dev-symbolic.svg">icons/scalable/apps/rouster-dev-symbolic.svg</file>
    <file preprocess="xml-stripblanks" alias="rouster-dups-symbolic.svg">icons/scalable/apps/rouster-dups-symbolic.svg</file>
    <file preprocess="xml-stripblanks" alias="rouster-archive-symbolic.svg">icons/scalable/apps/rouster-archive-symbolic.svg</file>
    <file preprocess="xml-stripblanks" alias="rouster-preflight-symbolic.svg">icons/scalable/apps/rouster-preflight-symbolic.svg</file>
    <file preprocess="xml-stripblanks" alias="rouster-activity-symbolic.svg">icons/scalable/apps/rouster-activity-symbolic.svg</file>
    <file preprocess="xml-stripblanks" alias="rouster-hero-scan.svg">icons/scalable/apps/rouster-hero-scan.svg</file>
    <file preprocess="xml-stripblanks" alias="rouster-hero-sweep.svg">icons/scalable/apps/rouster-hero-sweep.svg</file>
    <file preprocess="xml-stripblanks" alias="rouster-hero-dev.svg">icons/scalable/apps/rouster-hero-dev.svg</file>
    <file preprocess="xml-stripblanks" alias="rouster-hero-dups.svg">icons/scalable/apps/rouster-hero-dups.svg</file>
    <file preprocess="xml-stripblanks" alias="rouster-hero-archive.svg">icons/scalable/apps/rouster-hero-archive.svg</file>
    <file preprocess="xml-stripblanks" alias="rouster-hero-preflight.svg">icons/scalable/apps/rouster-hero-preflight.svg</file>
    <file preprocess="xml-stripblanks" alias="rouster-hero-activity.svg">icons/scalable/apps/rouster-hero-activity.svg</file>
    <file preprocess="xml-stripblanks" alias="rouster-hero-logo.svg">icons/scalable/apps/rouster-hero-logo.svg</file>
    <file preprocess="xml-stripblanks" alias="rouster-hero-done.svg">icons/scalable/apps/rouster-hero-done.svg</file>
  </gresource>
  <gresource prefix="/io/github/scott8420/Rouster">
    <file>rouster.css</file>
  </gresource>
</gresources>
